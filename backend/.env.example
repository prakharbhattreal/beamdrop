# Server
PORT=3001

# Comma-separated list of frontend origins allowed to call the API and open the WebSocket
ALLOWED_ORIGINS=http://localhost:3000

# Set to true only when running behind a reverse proxy you control
# (then the client IP is read from X-Forwarded-For)
TRUST_PROXY=false

# Optional TURN server (coturn "use-auth-secret" style). Without these, STUN only.
TURN_URL=
TURN_SECRET=
TURN_TTL_SECONDS=600
